name = "cryptic-atlas-harvester"
main = "worker.mjs"
compatibility_date = "2026-11-13"
workers_dev = false

[triggers]
# Proposed daily run; deployment is not active.
crons = ["17 17 * * *"]

[[d1_databases]]
binding = "ATLAS_DB"
database_name = "REPLACE_WITH_APPROVED_DATABASE_NAME"
database_id = "REPLACE_WITH_APPROVED_D1_DATABASE_ID"
migrations_dir = "migrations"

# Optional: set ATLAS_RUN_TOKEN as a Worker secret for authenticated POST /run.
# Do not put credentials in this file or in Git.
